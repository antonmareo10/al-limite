hare similar details.","origen_es":"modelo","origen_en":"modelo","modelo":"Qwen3-4B (Q4_K_M, llama.cpp)","regla":"obras","citas":["fothFJwUw8DgL1BHd3qjQA%3D%3D","vy0webEEQBRPpzdqOdhuWg%3D%3D","8MkvYF%2FoRBiLAncw3qdZkA%3D%3D"],"generado":"2026-11-15"}}